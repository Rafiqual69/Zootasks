# Local/development defaults. Keep real secrets only in the deployment provider's
# secret/variable store; never commit a real .env file.

DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-email
EMAIL_HOST_PASSWORD=replace-with-email-app-password
DEFAULT_FROM_EMAIL=ZooTasks <noreply@zootasks.com>

TELEGRAM_BOT_TOKEN=replace-with-botfather-token

AIRTM_ENVIRONMENT=sandbox
AIRTM_API_KEY=replace-with-airtm-api-key
AIRTM_API_SECRET=replace-with-airtm-api-secret

OWNER_USERNAME=
AI_AGENT_TRUST_KEY=replace-with-at-least-32-random-bytes
OWNER_CONTROL_STATE=DEVELOPMENT_SINGLE_DEVICE

PRODUCTION_MODE=False
SECURE_SSL_REDIRECT=False
SECURE_COOKIES=False
TRUST_PROXY_SSL=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
