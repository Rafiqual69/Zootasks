DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-email
EMAIL_HOST_PASSWORD=replace-with-email-app-password

# OAuth credentials: keep real values in hosting-provider secrets only.
# Blank values disable that provider until its developer app is configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
YAHOO_OAUTH_CLIENT_ID=
YAHOO_OAUTH_CLIENT_SECRET=

# Meta WhatsApp Business Cloud API (keep real values in hosting secrets).
# OTP login stays disabled until all required values are configured and the
# authentication template is approved by Meta.
META_WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_HASH_KEY=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_API_VERSION=v26.0
META_WHATSAPP_OTP_TEMPLATE_NAME=zootasks_login_otp
META_WHATSAPP_OTP_LANGUAGE_CODE=en_US


TELEGRAM_BOT_TOKEN=replace-with-botfather-token

AIRTM_ENVIRONMENT=sandbox
AIRTM_API_KEY=replace-with-airtm-api-key
AIRTM_API_SECRET=replace-with-airtm-api-secret

# High-assurance Owner account
OWNER_USERNAME=

# Transport security (enable in production behind HTTPS)
PRODUCTION_MODE=False
SECURE_SSL_REDIRECT=False
SECURE_COOKIES=False
TRUST_PROXY_SSL=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
