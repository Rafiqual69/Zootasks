{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ZooTasks AI Evaluation Evidence",
  "type":"object",
  "required":["evidence_type","schema_version","system_id","capability","evaluation_dataset_version","generated_at","environment","production_provider_invoked","summary","cases","provenance","integrity"],
  "properties":{
    "evidence_type":{"const":"zootasks.ai.security_evaluation"},
    "schema_version":{"const":"1.0"},
    "system_id":{"const":"AI-SYS-001"},
    "capability":{"type":"string"},
    "evaluation_dataset_version":{"type":"string"},
    "generated_at":{"type":"string","format":"date-time"},
    "environment":{"type":"object","required":["python","platform","django_settings"],"additionalProperties":false,"properties":{"python":{"type":"string"},"platform":{"type":"string"},"django_settings":{"type":"string"}}},
    "production_provider_invoked":{"const":false},
    "summary":{"type":"object","required":["total","passed","failed","status"],"additionalProperties":false,"properties":{"total":{"type":"integer","minimum":0},"passed":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"status":{"enum":["PASS","FAIL"]}}},
    "cases":{"type":"array","minItems":1,"items":{"type":"object","required":["case_id","group","expected","status","checks"],"properties":{"case_id":{"type":"string"},"group":{"type":"string"},"expected":{"type":"string"},"status":{"enum":["PASS","FAIL"]},"checks":{"type":"array"},"error":{"type":"string"}},"additionalProperties":false}},
    "provenance":{"type":"object","required":["git_commit","runner_version","source_revision_digest","dataset_version","dataset_sha256","schema_version"],"additionalProperties":false,"properties":{"git_commit":{"type":"string","minLength":1},"runner_version":{"type":"string","minLength":1},"source_revision_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"dataset_version":{"type":"string","minLength":1},"dataset_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"schema_version":{"const":"1.0"}}},
    "integrity":{"type":"object","required":["algorithm","evidence_sha256"],"additionalProperties":false,"properties":{"algorithm":{"const":"sha256"},"evidence_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
  },
  "additionalProperties":false
}