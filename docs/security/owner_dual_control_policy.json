{
  "policy_id": "ZT-OWNER-DUAL-CONTROL",
  "policy_version": "1.0.0",
  "status": "proposed",
  "activation": "production_readiness_gate",
  "default_decision": "deny",
  "approval_model": "two_independent_owner_devices",
  "current_development_mode": {
    "existing_owner_device_allowed": true,
    "dual_control_required": false,
    "scope": "non_production_development_operations_only"
  },
  "protected_operations": [
    "production_deploy",
    "production_rollback",
    "security_policy_change",
    "owner_privilege_change",
    "authentication_control_change",
    "production_security_configuration_change",
    "migration_promotion",
    "recovery_promotion",
    "financial_write",
    "withdrawal_approval",
    "withdrawal_payment",
    "secret_rotation_with_operational_impact",
    "network_exposure_change",
    "irreversible_deletion",
    "break_glass_operation"
  ],
  "requirements": {
    "independent_device_identities": true,
    "phishing_resistant_authentication": true,
    "action_binding": true,
    "target_binding": true,
    "parameter_binding": true,
    "short_lived_approval": true,
    "replay_protection": true,
    "revocation": true,
    "execution_time_reauthorization": true,
    "audit_metadata_without_secrets": true
  },
  "deny_conditions": [
    "missing_second_approval",
    "expired_approval",
    "revoked_device",
    "duplicate_or_replayed_approval",
    "approval_parameter_mismatch",
    "ambiguous_device_identity",
    "policy_validation_failure",
    "failed_required_ci",
    "failed_required_review",
    "active_security_freeze",
    "suspected_single_anchor_compromise",
    "secret_exposure_risk"
  ],
  "automation": {
    "may_prepare_request": true,
    "may_validate_request": true,
    "may_execute_dual_control_action_without_two_owner_approvals": false,
    "may_create_or_replay_owner_approval": false
  },
  "human_approval_required": true,
  "precedence": "most_restrictive_wins",
  "primary_owner_input_device": {
    "mode": "one_enrolled_primary_device_as_owner_input_surface",
    "status": "required_not_yet_implemented",
    "allowed_input_classes": [
      "instructions",
      "research_requests",
      "drafts",
      "configuration_proposals",
      "monitoring_queries",
      "approval_requests"
    ],
    "authentication": [
      "fresh_phishing_resistant_webauthn",
      "explicit_owner_confirmation",
      "server_side_session_binding",
      "csrf_protection",
      "expiry_and_revocation"
    ],
    "device_id_is_authorization_by_itself": false,
    "grants_blanket_write_access": false,
    "protected_production_operations_bypass_dual_control": false,
    "compromised_device_response": [
      "freeze_privileged_mutations",
      "revoke_credential",
      "invalidate_sessions",
      "audit_and_notify"
    ],
    "recovery_requires": [
      "independent_owner_reauthentication",
      "audited_reenrollment",
      "old_device_revocation"
    ],
    "never_store": [
      "private_authenticator_keys",
      "raw_recovery_codes",
      "session_cookies",
      "authentication_secrets"
    ]
  }
}
