{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "bash /app/backend/release_predeploy.sh"
    ],
    "startCommand": "cd /app/backend && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT",
    "restartPolicyType": "ALWAYS"
  }
}
